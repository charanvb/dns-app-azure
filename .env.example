# Copy to .env for local development. Never commit the real .env file.

APP_NAME=Azure DNS Self Service Portal
ENVIRONMENT=development
PORT=8000

DNS_SUBSCRIPTION_ID=
DNS_RESOURCE_GROUP=

# Isolated Postgres database created via db/provision_dns_selfservice_db.sql
DATABASE_URL=postgresql+psycopg2://dns_selfservice_app:CHANGE_ME@your-postgres-host:5432/dns_selfservice?sslmode=require

# Random secret for signing session cookies, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Logic App HTTP trigger URL used to send email notifications
LOGIC_APP_EMAIL_URL=
